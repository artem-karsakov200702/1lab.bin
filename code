};

int main()
{
    setlocale(LC_ALL, "Russian");

    int choice;
    Car car;

    do
    {
        cout << "\n===== КАТАЛОГ АВТОМОБИЛЕЙ =====\n";
        cout << "1. Ввод данных\n";
        cout << "2. Вывод всех\n";
        cout << "3. Поиск\n";
        cout << "4. Выход\n";
        cout << "Выберите пункт: ";
        cin >> choice;

        switch (choice)
        {
        case 1:
        {
            cout << "\n===== ВВОД ДАННЫХ =====\n";

            cout << "Введите марку: ";
            cin >> car.brand;

            cout << "Введите модель: ";
            cin >> car.model;

            cout << "Введите год выпуска: ";
            cin >> car.year;

            cout << "Введите цену: ";
            cin >> car.price;

            cout << "Введите объем двигателя: ";
            cin >> car.engine;

            cout << "Введите тип кузова: ";
            cin >> car.body;

            ofstream file("cars.dat", ios::binary | ios::app);

            if (file)
            {
                file.write((char*)&car, sizeof(Car));
                file.close();

                cout << "\nДанные сохранены.\n";
            }
            else
            {
                cout << "\nОшибка открытия файла.\n";
            }

            break;
        }

        case 2:
        {
            ifstream file("cars.dat", ios::binary);

            if (!file)
            {
                cout << "\nФайл не найден.\n";
                break;
            }

            cout << "\n===== ВСЕ АВТОМОБИЛИ =====\n";

            while (file.read((char*)&car, sizeof(Car)))
            {
                cout << "\nМарка: " << car.brand;
                cout << "\nМодель: " << car.model;
                cout << "\nГод выпуска: " << car.year;
                cout << "\nЦена: " << car.price;
                cout << "\nОбъем двигателя: " << car.engine;
                cout << "\nТип кузова: " << car.body;
                cout << "\n--------------------------\n";
            }

            file.close();

            break;
        }

        case 3:
        {
            int searchChoice;

            do
            {
                cout << "\n===== ПОИСК =====\n";
                cout << "1. По марке\n";
                cout << "2. По модели\n";
                cout << "3. По году\n";
                cout << "4. По цене\n";
                cout << "5. По объему двигателя\n";
                cout << "6. По типу кузова\n";
                cout << "0. Назад\n";
                cout << "Выберите пункт: ";
                cin >> searchChoice;

                switch (searchChoice)
                {
                case 1:
                {
                    char brand[20];

                    cout << "\nВведите марку: ";
                    cin >> brand;

                    ifstream file("cars.dat", ios::binary);

                    if (!file)
                    {
                        cout << "Файл не найден.\n";
