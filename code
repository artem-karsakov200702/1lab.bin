                            cout << "\nГод выпуска: " << car.year;
                            cout << "\nЦена: " << car.price;
                            cout << "\nОбъем двигателя: " << car.engine;
                            cout << "\nТип кузова: " << car.body << "\n";

                            found = true;
                        }
                    }

                    if (!found)
                        cout << "Автомобили не найдены.\n";

                    file.close();

                    break;
                }

                case 6:
                {
                    char body[20];

                    cout << "\nВведите тип кузова: ";
                    cin >> body;

                    ifstream file("cars.dat", ios::binary);

                    if (!file)
                    {
                        cout << "Файл не найден.\n";
