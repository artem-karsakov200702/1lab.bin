                    cout << "\nВведите минимальный год: ";
                    cin >> minYear;

                    cout << "Введите максимальный год: ";
                    cin >> maxYear;

                    ifstream file("cars.dat", ios::binary);

                    if (!file)
                    {
                        cout << "Файл не найден.\n";
                        break;
                    }

                    bool found = false;

                    while (file.read((char*)&car, sizeof(Car)))
                    {
                        if (car.year >= minYear && car.year <= maxYear)
