                            cout << "\nМодель: " << car.model;
                            cout << "\nГод выпуска: " << car.year;
                            cout << "\nЦена: " << car.price;
                            cout << "\nОбъем двигателя: " << car.engine;
                            cout << "\nТип кузова: " << car.body << "\n";

                            found = true;
                        }
                    }

                    if (!found)
                        cout << "Автомобили не найдены.\n";

                    file.close();

                    break;
                }

                case 0:
                    break;

                default:
                    cout << "Неверный пункт меню.\n";
